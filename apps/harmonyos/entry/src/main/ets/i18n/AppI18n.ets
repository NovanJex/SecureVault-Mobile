const EN_DICT: Map<string, string> = new Map<string, string>(EN_PAIRS);

export function isZhLocale(): boolean {
  try {
    const lang: string = i18n.System.getSystemLanguage();
    return lang.toLowerCase().startsWith('zh');
  } catch (_) {
    return true;
  }
}

export function t(zh: string): string {
  if (isZhLocale()) {
    return zh;
  }
  const en = EN_DICT.get(zh);
  return en !== undefined ? en : zh;
}

export function tf(zh: string, en: string, vars: Record<string, string | number>): string {
  let out = isZhLocale() ? zh : en;
  const keys = Object.keys(vars);
  for (let i = 0; i < keys.length; i++) {
    const k = keys[i];
    const v = String(vars[k]);
    out = out.split(`{${k}}`).join(v);
  }
  return out;
}
